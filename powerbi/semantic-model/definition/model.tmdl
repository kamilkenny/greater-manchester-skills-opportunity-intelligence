model Model
	culture: en-US
	collation: Latin1_General_100_BIN2_UTF8
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DatabaseQuery"]

annotation PBI_ProTooling = ["WebModelingEdit"]

ref table skills_supply
ref table mbacc_pathway
ref table youth_transition
ref table borough_opportunity
ref table borough
ref table mbacc_gateway
ref table ssa_subject
ref table apprenticeship_level
ref table apprenticeship_lad
ref table apprenticeship_detail
ref table time_period
ref table labour_market_period

